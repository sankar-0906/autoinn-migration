model UserBranchAccess {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId  String?  @map("branch")
  branch    Branch?  @relation("UserBranchAccessToBranch", fields: [branchId], references: [id])
  userId    String?  @map("user")
  user      User?    @relation("UserBranchAccessToUser", fields: [userId], references: [id])
}

model UserManagement {
  id        String   @id @default(cuid())
  username  String?
  password  String?
  name      String?
  role      String?
  email     String?
  mobile    String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
