  partNumber            PartsMaster?          @relation("PartNoRelatedToPartsMaster", fields: [partNumberId], references: [id])
  hsnId                 String?               @map("hsn")
  hsn                   Hsn?                  @relation("PurchaseSpareInvoiceItemHasHSN", fields: [hsnId], references: [id])
