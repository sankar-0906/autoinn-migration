  id        String   @id @default(cuid())
  name      String
  url       String
  status    Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id            String       @id @default(cuid())
  taskId        String?
  executionTime DateTime?
  senderId      String?
  status        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  groupId       String?
  group         Group?       @relation("TaskHasGroup", fields: [groupId], references: [id])
  messageId     String?
  message       Message?     @relation("TaskHasMessage", fields: [messageId], references: [id])
  createdById   String?
  createdBy     User?        @relation("TasksWasCreatedByUser", fields: [createdById], references: [id])
  smsDetails    SmsHistory[] @relation("TaskHasManySmsHistory")
}

model Group {
  id          String    @id @default(cuid())
  groupName   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  filterId    String?   @unique @map("filter")
  filter      Filter?   @relation("GroupHasFilter", fields: [filterId], references: [id])
  createdById String?   @map("createdBy")
  createdBy   User?     @relation("GroupWasCreatedByUser", fields: [createdById], references: [id])
  customers   Customer[] @relation("GroupHasCustomer")
  tasks       Task[]    @relation("TaskHasGroup")
}

// REMINDER: Run SQL migration for model, gender, customerType, etc. (Option 2)
model Filter {
  id               String    @id @default(cuid())
  model            String[]
  allModel         Boolean?
  from             DateTime?
  to               DateTime?
  gender           String[]
  allGender        Boolean?
  customerType     String[]
  allCustomerType  Boolean?
  customerGrouping String[]
  allCustomerGrouping Boolean?
  leadStage        String[]
  allLeadStage     Boolean?
  fromAge          Int?
  toAge            Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group            Group?    @relation("GroupHasFilter")
}

model Message {
  id            String   @id @default(cuid())
  promotionName String?
  sms           String?
  legends       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdById   String?
  createdBy     User?    @relation("MessageWasCreatedByUser", fields: [createdById], references: [id])
  tasks         Task[]   @relation("TaskHasMessage")
}

model SmsJob {
  id            String    @id @default(cuid())
  eventType     String?
  status        String?
  body          String?
  phone         String?
  contactType   String?
  scheduledTime DateTime?
  attempts      Int?
  taskId        String?
  senderId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// SUPPORTING TYPES (EXTRACTED)
// ============================================

model Activity {
  id                  String    @id @default(cuid())
  activityId          String?
  scheduleDateAndTime DateTime?
  quotationState      String?
  phone               String?
  duration            String?
  callId              String?
  enquiryType         String?
  interactionType     String?
  activityType        String?
  sentStatus          Boolean?
  sentWhatsApp        Boolean?
  remarks             String?
  discardMsg          String?
  callHistoryId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customerId       String?            @map("customer")
  customer         Customer?          @relation("CustomerHasActivities", fields: [customerId], references: [id])
  quotationId      String?            @map("quotation")
  quotation        Quotation?         @relation("ActivitiesHaveQuotation", fields: [quotationId], references: [id])
  bookingId        String?            @map("booking")
  booking          Booking?           @relation("ActivitiesHaveBooking", fields: [bookingId], references: [id])
  smsId            String?            @map("sms")
  sms              SmsHistory?        @relation("ActivitiesHasSmsHistory", fields: [smsId], references: [id])
  callHistoryRefId String?            @map("callHistory")
  callHistory      CloudCallHistory?  @relation("ActivitiesHaveCloudCallHistory", fields: [callHistoryRefId], references: [id])
  createdById      String?            @map("createdBy")
  createdBy        User?              @relation("ActivityWasCreatedByUser", fields: [createdById], references: [id])
}

model CustomerSpareOrder {
  id              String    @id @default(cuid())
  orderNumber     String?
  orderDate       DateTime?
  orderType       OrderType?
  discountType    String?
  discountAmount  Float?
  discountlevel   String?
  GrandTotal      Float?
  Advance         Float?
  Balance         Float?
  convertedData   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicleId       String?           @map("soldVehicle")
  soldVehicle     Vehicle?          @relation("VehicleHasCustomerSpareOrders", fields: [vehicleId], references: [id])
  jobCardId       String?           @map("jobCard")
  jobCard         JobOrder?         @relation("CustomerSpareOrderHasJobOrder", fields: [jobCardId], references: [id])
  partyNameId     String?           @map("partyName")
  partyName       Customer?         @relation("CustomerSpareOrderHasCustomer", fields: [partyNameId], references: [id])
  branchId        String?           @map("branch")
  branch          Branch?           @relation("CustomerSpareOrderHasBranch", fields: [branchId], references: [id])
  sparePartOrders SparePartOrder[]  @relation("SparePartOrderHasCustomerOrder")
  customerSpareOrderItem           CustomerSpareOrderItem[] @relation("ItemRelatedToCustomerSpareOrder")
}

model VehiclePurchaseInvoice {
  id             String    @id @default(cuid())
  invoiceNo      String?
  date           DateTime?
  invoiceDate    DateTime?
  quantity       Int?
  amount         Float?
  grossTotal     Float?
  netAmount      Float?
  roundOff       Float?
  others         Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  purchaseChallanId  String?
  purchaseChallan    VehiclePurchaseChallan? @relation("PurchaseInvoiceHasPurchaseChallan", fields: [purchaseChallanId], references: [id])
  createdById        String?
  createdBy          User?                   @relation("PurchaseInvoiceWasCreatedByUser", fields: [createdById], references: [id])

  vehicleInventory VehicleInventory[] @relation("VehicleTransactionsHavePurchasedSpares")
  purchaseReturns  VehiclePurchaseReturn[] @relation("PurchaseReturnHasPurchaseInvoice")
}

// ============================================
// MISSING MODELS FROM ORIGINAL SCHEMA
// ============================================

enum PlateOrderStatus {
  ORDERED
  RECEIVED
  FIXED
}

model CustomerSpareOrderItem {
  id                   String              @id @default(cuid())
  quantity             Float?
  unitRate             Float?
  discount             Float?
  grossAmount          Float?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  partNumberId         String?             @map("partNumber")
  partNumber           PartsMaster?        @relation("CustomerSparePartNoRelatedToPartsMaster", fields: [partNumberId], references: [id])
  customerSpareOrderId String?             @map("customerSpareOrder")
  customerSpareOrder   CustomerSpareOrder? @relation("ItemRelatedToCustomerSpareOrder", fields: [customerSpareOrderId], references: [id])
}

model VehiclePurchaseChallan {
  id                String                   @id @default(cuid())
  date              DateTime?
  challanNo         String?                  @unique
  challanDate       DateTime?
  supplierChallanNo String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  supplierId        String?
  supplier          Supplier?                @relation("PurchaseChallanHasSupplier", fields: [supplierId], references: [id])
  branchId          String?
  branch            Branch?                  @relation("PurchaseChallanHasBranch", fields: [branchId], references: [id])
  createdById       String?
  createdBy         User?                    @relation("PurchaseChallanWasCreatedByUser", fields: [createdById], references: [id])

  vehicleDetails    PurchasedVehicleDetail[] @relation("PurchaseChallanHasVehicleDetails")
  purchaseInvoices  VehiclePurchaseInvoice[] @relation("PurchaseInvoiceHasPurchaseChallan")
  purchaseReturns   VehiclePurchaseReturn[]  @relation("PurchaseReturnHasPurchaseChallan")
}

model PurchasedVehicleDetail {
  id                String                  @id @default(cuid())
  invoiceAmount     Float?
  chassisNo         String?
  engineNo          String?
  keyNo             String?
  warrantyBookNo    String?
  batteryNo         String?
  manMonthYear      String?
  sold              Boolean?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  vehicleId         String?                 @map("vehicle")
  vehicle           VehicleMaster?          @relation("VehicleDetailHasVehicleMaster", fields: [vehicleId], references: [id])
  colorId           String?                 @map("color")
  color             Image?                  @relation("VehicleDetailsHasColor", fields: [colorId], references: [id])
  purchaseChallanId String?                 @map("purchaseChallan")
  purchaseChallan   VehiclePurchaseChallan? @relation("PurchaseChallanHasVehicleDetails", fields: [purchaseChallanId], references: [id])
  createdById       String?                 @map("createdBy")
  createdBy         User?                   @relation("VehicleDetailWasCreatedByUser", fields: [createdById], references: [id])
  purchaseReturns   VehiclePurchaseReturn[] @relation("PurchaseReturnHasVehicleDetails")
}

model VehiclePurchaseReturn {
  id                String                  @id @default(cuid())
  date              DateTime?
  returnInvoiceNo   String?                 @unique
  quantity          Int?
  amount            Float?
  grossTotal        Float?
  netAmount         Float?
  roundOff          Float?
  others            Float?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  purchaseInvoiceId String?                 @map("purchaseInvoice")
  purchaseInvoice   VehiclePurchaseInvoice? @relation("PurchaseReturnHasPurchaseInvoice", fields: [purchaseInvoiceId], references: [id])
  purchaseChallanId String?                 @map("purchaseChallan")
  purchaseChallan   VehiclePurchaseChallan? @relation("PurchaseReturnHasPurchaseChallan", fields: [purchaseChallanId], references: [id])
  createdById       String?                 @map("createdBy")
  createdBy         User?                   @relation("PurchaseReturnWasCreatedByUser", fields: [createdById], references: [id])
  returnVehicle     PurchasedVehicleDetail[] @relation("PurchaseReturnHasVehicleDetails")
}

model FrameNumber {
  id             String        @id @default(cuid())
  position       Int?
  inputValue     String?
  inferredField  String?
  targetValue    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  manufacturerId String?       @map("manufacturer")
  manufacturer   Manufacturer? @relation("FrameNumberHasManufacturer", fields: [manufacturerId], references: [id])
  createdById    String?       @map("createdBy")
  createdBy      User?         @relation("FrameNumberWasCreatedByUser", fields: [createdById], references: [id])
}

model NumberPlate {
  id               String           @id @default(cuid())
  registerNo       String
  chassisNo        String
  engineNo         String?
  applicationType  String?          @default("NB")
  goodsCareerMGV   String?          @default("M-Cycle/Scooter~2WN~PETROL")
  makerName        String?          @default("INDIA YAMAHA MOTOR PVT LTD")
  modelName        String?
  customerName     String
  dealershipName   String?          @default("PACER MOTORS PVT LTD")
  applicationNo    String?
  plateOrderStatus PlateOrderStatus @default(ORDERED)
  eReceipt         String?
  // REMINDER: Migrate images from NumberPlate_images (Option 2)
  images           String[]
  orderedDate      DateTime?
  receivedDate     DateTime?
  registrationDate DateTime?
  fixedDate        DateTime?
  bookingId        String?
  branchName       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  locationId String?               @map("Location")
  Location   Branch?               @relation("BranchHasNumberPlate", fields: [locationId], references: [id])
  transfers  NumberPlateTransfer[] @relation("TransferredNumberPlate")
}

model NumberPlateTransfer {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())

  fromBranchId  String?     @map("fromBranch")
  fromBranch    Branch?      @relation("FromBranchTransfers", fields: [fromBranchId], references: [id])
  toBranchId    String?     @map("toBranch")
  toBranch      Branch?      @relation("ToBranchTransfers", fields: [toBranchId], references: [id])
  numberPlateId String?     @map("numberPlate")
  numberPlate   NumberPlate? @relation("TransferredNumberPlate", fields: [numberPlateId], references: [id])
}

model OtherInsuranceUploadHistory {
  id        Int      @id @default(autoincrement())
  filename  String?
  status    String?  @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingPayment {
  id                   String   @id @default(cuid())
  transactionId        String?  @unique
  orderId              String?
  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?
  status               String?
  amount               Float?
  amountRefunded       Float?
  modeOfPayment        String?
  bank                 String?
  cardDetails          Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CashWithdrawalHistory {
  id             String   @id @default(cuid())
  withdrawalDate DateTime
  totalAmount    Float
  accountBalance Float?
  createdAt      DateTime @default(now())

  branchId      String?  @map("branch")
  branch        Branch?  @relation("BranchHasCashWithdrawals", fields: [branchId], references: [id])
  withdrawnById String?  @map("withdrawnBy")
  withdrawnBy   User?    @relation("CashWithdrawnBy", fields: [withdrawnById], references: [id])

  denominations CashWithdrawalDenomination[] @relation("WithdrawalHasDenominations")
}

model CashWithdrawalDenomination {
  id                      String                       @id @default(cuid())
  denomination            Int
  count                   Int
  amount                  Float

  withdrawalId            String? @map("withdrawal")
  withdrawal              CashWithdrawalHistory?        @relation("WithdrawalHasDenominations", fields: [withdrawalId], references: [id])
  denominationInventoryId String? @map("denominationInventory")
  denominationInventory   CompanyDenominationInventory? @relation("DenominationInventoryUsedInWithdrawal", fields: [denominationInventoryId], references: [id])
}

// ============================================
// ADDITIONAL MISSING MODELS
// ============================================

model Pinelabs {
  id             String   @id @default(cuid())
  machineId      String?
  clientId       String?
  merchantId     String?
  storeId        String?
  securityToken  String?
  branch         String?
  MBR            Float?
  userIds        String[]
  accountBalance Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PartsTable {
  id          String   @id @default(cuid())
  refNo       String?
  partName    String?
  partNo      String?
  description String?
  B7JE        String?
  B7JF        String?
  B7JG        String?
  B7JH        String?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// FINAL MISSING MODELS
// ============================================

enum accountType {
  SAVINGS
  CURRENT
  OD
  CREDIT
  CARD
}

model Otp {
  id         String   @id @default(cuid())
  passcode   String?
  validTill  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DigitalLead {
  id                  String    @id @default(cuid())
  name                String?
  phone               String?
  scheduleDateAndTime DateTime?
  enquiryType         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customerId String?
  customer   Customer? @relation("DigitalLeadHasCustomer", fields: [customerId], references: [id])
}

model SalesTarget {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  employeeId  String?      @map("employee")
  employee    User?        @relation("SalesTargetHasUser", fields: [employeeId], references: [id])
  targetData  TargetData[] @relation("SalesTargetHasManyTargetData")
}

model TargetData {
  id           String      @id @default(cuid())
  monthly      Json?
  targetType   String?
  timeline     String?
  value        String?
  yearly       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  salesTargetId String?      @map("salesTarget")
  salesTarget   SalesTarget? @relation("SalesTargetHasManyTargetData", fields: [salesTargetId], references: [id])
}

