  branchId      String?            @map("branch")
  branch        Branch?            @relation("VehicleInsuranceHasBranch", fields: [branchId], references: [id])
  fileId        String?            @map("file")
  file          File?              @relation("VehicleInsuranceHasFiles", fields: [fileId], references: [id])
  vehicleId     String?            @map("vehicle")
  vehicle       Vehicle?           @relation("VehicleHaveVehicleInsurance", fields: [vehicleId], references: [id])
}

model MultiCustomer {
