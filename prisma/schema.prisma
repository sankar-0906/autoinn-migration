model PurchaseChallanHasVehicleDetails {
  A                      String                 @db.VarChar(25)
  B                      String                 @db.VarChar(25)
  VehiclePurchaseChallan VehiclePurchaseChallan @relation(fields: [A], references: [id], onDelete: Cascade, onUpdate: NoAction)
  PurchasedVehicleDetail PurchasedVehicleDetail @relation(fields: [B], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([A, B], map: "_PurchaseChallanHasVehicleDetails_AB_unique")
  @@index([B], map: "_PurchaseChallanHasVehicleDetails_B")
  @@map("_PurchaseChallanHasVehicleDetails")
}

