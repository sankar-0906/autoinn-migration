generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id        String    @id @default(cuid()) @db.VarChar(25)
  name      String    @unique(map: "default$default.Country.name._UNIQUE")
  sortName  String    @unique(map: "default$default.Country.sortName._UNIQUE")
  phoneCode String?
  createdAt DateTime
  updatedAt DateTime  @updatedAt
  addresses Address[] @relation("AddressHasCountry")
  State     State[]
}

model State {
  id        String    @id @default(cuid()) @db.VarChar(25)
  name      String
  createdAt DateTime
  updatedAt DateTime  @updatedAt
  country   String?   @db.VarChar(25)
  addresses Address[] @relation("AddressHasState")
  City      City[]
  Country   Country?  @relation(fields: [country], references: [id], onUpdate: NoAction)
}

model City {
  id        String    @id @default(cuid()) @db.VarChar(25)
  name      String
  createdAt DateTime
  updatedAt DateTime  @updatedAt
  state     String?   @db.VarChar(25)
  addresses Address[] @relation("AddressHasCity")
  State     State?    @relation(fields: [state], references: [id], onUpdate: NoAction)
  Rto       Rto[]
}

model Rto {
  id        String    @id @default(cuid()) @db.VarChar(25)
  code      String
  area      String
  createdAt DateTime
  updatedAt DateTime  @updatedAt
  city      String?   @db.VarChar(25)
  bookings  Booking[] @relation("BookingHasRTOData")
  City      City?     @relation(fields: [city], references: [id], onUpdate: NoAction)
}

model User {
  id                                            String                         @id @default(cuid()) @db.VarChar(25)
  phone                                         String?
  password                                      String?
  profilePicture                                String?
  status                                        Boolean?
  createdAt                                     DateTime
  updatedAt                                     DateTime                       @updatedAt
  lastLoginAt                                   DateTime?
  createdById                                   String?                        @map("createdBy") @db.VarChar(25)
  profile                                       String?                        @db.VarChar(25)
  phone2                                        String?                        @unique(map: "default$default.User.phone2._UNIQUE")
  customerDetails                               String?                        @db.VarChar(25)
  employee                                      Boolean?
  email                                         String?
  verified                                      Boolean?
  createdActivities                             Activity[]                     @relation("ActivityWasCreatedByUser")
  createdAddresses                              Address[]                      @relation("AddressWasCreatedByUser")
  createdAdjSpares                              AdjustSparesInventory[]        @relation("AdjustSparesInventoryHasUser")
  createdAutoCallTemplates                      AutoCallVoiceTemplate[]        @relation("AutoCallTemplateUpdatedBy")
  createdBanks                                  BankDetails[]                  @relation("CompanyBankDetailsWasCreatedByUser")
  createdBookings                               Booking[]                      @relation("BookingWasCreatedByUser")
  executiveBookings                             Booking[]                      @relation("BookingHasExecutive")
  changedBookingHistories                       BookingHistory[]               @relation("BookingHistoryChangedBy")
  createdBranches                               Branch[]                       @relation("BranchWasCreatedByUser")
  cashWithdrawals                               CashWithdrawalHistory[]        @relation("CashWithdrawnBy")
  createdCos                                    Company[]                      @relation("CompanyWasCreatedByUser")
  updatedDenomInv                               CompanyDenominationInventory[] @relation("CompanyDenominationUpdatedBy")
  createdCustomers                              Customer[]                     @relation("CustomerWasCreatedByUser")
  createdCustomerPhones                         CustomerPhone[]                @relation("CustomerPhoneWasCreatedByUser")
  createdDepts                                  Department[]                   @relation("DepartmentWasCreatedBy")
  createdDocuments                              EmployeeDocument[]             @relation("UserDocumentWasCreatedBy")
  createdProfiles                               EmployeeProfile[]              @relation("UserProfileWasCreatedBy")
  createdEstimates                              Estimate[]                     @relation("EstimateWasCreatedBy")
  createdEstimateItems                          EstimateItem[]                 @relation("EstimateItemWasCreatedBy")
  File                                          File[]
  FileManagement                                FileManagement[]
  createdFinancers                              Financer[]                     @relation("FinancerWasCreatedByUser")
  createdFinConts                               FinancerContact[]              @relation("FinancerContactWasCreatedByUser")
  createdFrameNumbers                           FrameNumber[]                  @relation("FrameNumberWasCreatedByUser")
  createdGroups                                 Group[]                        @relation("GroupWasCreatedByUser")
  Hsn                                           Hsn[]
  Image                                         Image[]
  createdInsurers                               Insurance[]                    @relation("InsuranceWasCreatedByUser")
  createdInsConts                               InsuranceContact[]             @relation("InsuranceContactWasCreatedByUser")
  createdInsTypes                               InsuranceType[]                @relation("InsTypeWasCreatedByUser")
  createdJobCodes                               JobCode[]                      @relation("JobCodeWasCreatedBy")
  JobInvoice                                    JobInvoice[]
  createdJobOrders                              JobOrder[]                     @relation("JobOrderWasCreatedBy")
  mechanicJobOrders                             JobOrder[]                     @relation("JobOrderHasMechanic")
  createdComplaints                             JobVehicleComplaint[]          @relation("ComplaintWasCreatedBy")
  createdJVImages                               JobVehicleImage[]              @relation("JobVehicleImageWasCreatedBy")
  createdJVParts                                JobVehicleParts[]              @relation("JobVehiclePartsWasCreatedBy")
  deletedJVParts                                JobVehicleParts[]              @relation("JobVehiclePartsWasDeletedBy")
  Ledger                                        Ledger[]
  createdManufacturers                          Manufacturer[]                 @relation("ManufacturerWasCreatedByUser")
  createdMaterialIs                             MaterialIssue[]                @relation("MaterialIssueWasCreatedBy")
  mechanicMaterialIssues                        MaterialIssue[]                @relation("MaterialIssueHasMechanic")
  mechanicMaterialParts                         MaterialPartsIssue[]           @relation("MaterialPartsIssueHasMechanic")
  Message                                       Message[]
  createdMultiCustomers                         MultiCustomer[]                @relation("MultiCustomerWasCreatedByUser")
  MultiVehicle                                  MultiVehicle[]
  OptionalType                                  OptionalType[]
  createdParts                                  PartsMaster[]                  @relation("PartsMasterWasCreatedBy")
  createdVehicleDetails                         PurchasedVehicleDetail[]       @relation("VehicleDetailWasCreatedByUser")
  assignedExecQuotations                        Quotation[]                    @relation("QuotationAssignedExecutive")
  createdQuotations                             Quotation[]                    @relation("QuotationWasCreatedByUser")
  executiveQuotations                           Quotation[]                    @relation("QuotationHasExecutive")
  createdQuotPrices                             QuotationPrice[]               @relation("QuotationPriceWasCreatedBy")
  createdQuotVehicles                           QuotationVehicle[]             @relation("QuotationVehicleWasCreatedByUser")
  Ramp                                          Ramp[]
  Sac                                           Sac[]
  createdSaleInvoices                           SaleInvoice[]                  @relation("SaleInvoiceWasCreatedByUser")
  createdSaleRegisters                          SaleRegister[]                 @relation("SaleRegisterWasCreatedByUser")
  salesTargets                                  SalesTarget[]                  @relation("SalesTargetHasUser")
  Service                                       Service[]
  SmsTemplate                                   SmsTemplate[]
  createdStockCh                                StockCheck[]                   @relation("StockCheckHasCreatedByUser")
  createdSubs                                   SubDealer[]                    @relation("SubDealerWasCreatedByUser")
  SubDealerContact                              SubDealerContact[]
  createdSuppliers                              Supplier[]                     @relation("SupplierWasCreatedByUser")
  createdSupConts                               SupplierContact[]              @relation("SupplierContactWasCreatedByUser")
  Task                                          Task[]
  createdBy                                     User?                          @relation("UserWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  createdUsers                                  User[]                         @relation("UserWasCreatedByUser")
  Customer_User_customerDetailsToCustomer       Customer?                      @relation("User_customerDetailsToCustomer", fields: [customerDetails], references: [id], onUpdate: NoAction)
  EmployeeProfile_User_profileToEmployeeProfile EmployeeProfile?               @relation("User_profileToEmployeeProfile", fields: [profile], references: [id], onUpdate: NoAction)
  createdVehicles                               Vehicle[]                      @relation("SoldVehicleWasCreatedByUser")
  VehicleMaster                                 VehicleMaster[]
  VehicleInventory                              VehicleInventory[]
  createdVehPrices                              VehiclePrice[]                 @relation("VehiclePriceWasCreatedBy")
  VehiclePurchaseChallan                        VehiclePurchaseChallan[]
  VehiclePurchaseInvoice                        VehiclePurchaseInvoice[]
  createdPurchaseReturns                        VehiclePurchaseReturn[]        @relation("PurchaseReturnWasCreatedByUser")
  createdPurchaseSpareInvoices                  PurchaseSpareInvoice[]         @relation("PurchaseSpareInvoiceWasCreatedBy")
  WhatsappPromotion                             WhatsappPromotion[]
  WhatsappTemplate                              WhatsappTemplate[]
  idCreation                                    idCreation[]
  branches                                      Branch[]                       @relation("BranchHasManyUser")
}

model EmployeeProfile {
  id                                 String             @id @unique(map: "UserProfile_pkey") @default(cuid()) @db.VarChar(25)
  employeeName                       String?
  fatherName                         String?
  dateOfBirth                        DateTime?
  bloodGroup                         String?
  createdAt                          DateTime
  updatedAt                          DateTime           @updatedAt
  createdById                        String?            @map("createdBy") @db.VarChar(25)
  addressId                          String?            @map("address") @db.VarChar(25)
  dateOfJoining                      DateTime?
  bankDetailsId                      String?            @map("bankDetails") @db.VarChar(25)
  departmentId                       String?            @map("department") @db.VarChar(25)
  employeeId                         String?
  companyPayments                    CompanyPayment[]   @relation("CompanyPaymentPaidByEmployee")
  documents                          EmployeeDocument[] @relation("UserHasUserDocument")
  address                            Address?           @relation("UserProfileHasAddress", fields: [addressId], references: [id], onUpdate: NoAction)
  bankDetails                        BankDetails?       @relation("UserProfileHasBankDetails", fields: [bankDetailsId], references: [id], onUpdate: NoAction)
  createdBy                          User?              @relation("UserProfileWasCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  department                         Department?        @relation("EmployeeProfileHasDepartment", fields: [departmentId], references: [id], onUpdate: NoAction)
  collectedPayments                  Payment[]          @relation("CashierCollectedPayment")
  User_User_profileToEmployeeProfile User[]             @relation("User_profileToEmployeeProfile")
  branch                             Branch[]           @relation("UserProfileHasBranch")
}

model EmployeeDocument {
  id            String           @id @unique(map: "UserDocument_pkey") @default(cuid()) @db.VarChar(25)
  type          String?
  typeValue     String?
  createdAt     DateTime
  updatedAt     DateTime         @updatedAt
  filesId       String?          @map("files") @db.VarChar(25)
  userProfileId String?          @map("userProfile") @db.VarChar(25)
  createdById   String?          @map("createdBy") @db.VarChar(25)
  createdBy     User?            @relation("UserDocumentWasCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  files         File?            @relation("UserDocumentHasFile", fields: [filesId], references: [id], onUpdate: NoAction)
  userProfile   EmployeeProfile? @relation("UserHasUserDocument", fields: [userProfileId], references: [id], onUpdate: NoAction)
}

model Department {
  id                        String                      @id @default(cuid()) @db.VarChar(25)
  role                      String                      @unique(map: "default$default.Department.role._UNIQUE")
  createdAt                 DateTime
  updatedAt                 DateTime                    @updatedAt
  createdById               String?                     @map("createdBy") @db.VarChar(25)
  othersAccess              Boolean?
  departmentType            String[]
  createdBy                 User?                       @relation("DepartmentWasCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  // Department_departmentType Department_departmentType[]
  employeeProfiles          EmployeeProfile[]           @relation("EmployeeProfileHasDepartment")
  RoleAccess                RoleAccess[]                @relation("DepartmentHasRoleAccess")
}

model RoleAccess {
  id         String       @id @default(cuid()) @db.VarChar(25)
  createdAt  DateTime
  updatedAt  DateTime     @updatedAt
  accessId   String?      @map("access") @db.VarChar(25)
  master     String?
  subModule  String?
  access     Access?      @relation("RoleAccessHasAccess", fields: [accessId], references: [id], onUpdate: NoAction)
  Department Department[] @relation("DepartmentHasRoleAccess")
}

model Access {
  id         String       @id @default(cuid()) @db.VarChar(25)
  create     Boolean?
  update     Boolean?
  delete     Boolean?
  read       Boolean?
  print      Boolean?
  roleAccess RoleAccess[] @relation("RoleAccessHasAccess")
}

model Company {
  id            String   @id @default(cuid()) @db.VarChar(25)
  name          String
  cin           String?
  pan           String?
  logo          String?
  website       String?
  createdAt     DateTime
  updatedAt     DateTime @updatedAt
  createdById   String?  @map("createdBy") @db.VarChar(25)
  email         String?
  contactPerson String?
  phone         String?
  branches      Branch[] @relation("CompanyHasManyBranch")
  createdBy     User?    @relation("CompanyWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
}

model CompanyPayment {
  id              String              @id @default(cuid()) @db.VarChar(25)
  module          String?
  moduleId        String?
  billAmount      Decimal?
  collectedAmount Decimal?
  paymentType     String?
  status          String?
  paymentMode     String?
  createdAt       DateTime
  updatedAt       DateTime            @updatedAt
  paidById        String?             @map("paidBy") @db.VarChar(25)
  bankDetailsId   String?             @map("bankDetails") @db.VarChar(25)
  accountBalance  Decimal?
  branchId        String?             @map("branch") @db.VarChar(25)
  bankDetails     BankDetails?        @relation("CompanyPaymentBankDetails", fields: [bankDetailsId], references: [id], onUpdate: NoAction)
  branch          Branch?             @relation("BranchHasCompanyPayments", fields: [branchId], references: [id], onUpdate: NoAction)
  paidBy          EmployeeProfile?    @relation("CompanyPaymentPaidByEmployee", fields: [paidById], references: [id], onUpdate: NoAction)
  denominations   DenominationEntry[] @relation("CompanyPaymentHasDenominations")
  Financer        Financer[]          @relation("FinancerUsedForCompanyPayment")
}

model Branch {
  id                                                                   String                         @id @default(cuid()) @db.VarChar(25)
  name                                                                 String?
  branchType                                                           String?
  createdAt                                                            DateTime
  updatedAt                                                            DateTime                       @updatedAt
  createdById                                                          String?                        @map("createdBy") @db.VarChar(25)
  addressId                                                            String?                        @map("address") @db.VarChar(25)
  gst                                                                  String?
  companyId                                                            String?                        @map("company") @db.VarChar(25)
  senderId                                                             String?
  email                                                                String?
  url                                                                  String?
  noOfRamps                                                            Int?
  lat                                                                  Decimal?
  lon                                                                  Decimal?
  accountBalance                                                       Decimal?
  googleMapUrl                                                         String?
  adjustSpares                                                         AdjustSparesInventory[]        @relation("AdjustSparesInventoryHasBranch")
  bookings                                                             Booking[]                      @relation("BookingHasBranch")
  address                                                              Address?                       @relation("BranchHasAddress", fields: [addressId], references: [id], onUpdate: NoAction)
  company                                                              Company?                       @relation("CompanyHasManyBranch", fields: [companyId], references: [id], onUpdate: NoAction)
  createdBy                                                            User?                          @relation("BranchWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  cashWithdrawals                                                      CashWithdrawalHistory[]        @relation("BranchHasCashWithdrawals")
  denomInventory                                                       CompanyDenominationInventory[] @relation("BranchHasDenominationInventory")
  companyPayments                                                      CompanyPayment[]               @relation("BranchHasCompanyPayments")
  customerSpareOrders                                                  CustomerSpareOrder[]           @relation("CustomerSpareOrderHasBranch")
  denomEntries                                                         DenominationEntry[]            @relation("BranchHasDenominationEntries")
  estimates                                                            Estimate[]                     @relation("EstimateHasBranch")
  jobOrders                                                            JobOrder[]                     @relation("JobOrderHasBranch")
  Ledger                                                               Ledger[]
  materialIssues                                                       MaterialIssue[]                @relation("MaterialIssueHasBranch")
  materialParts                                                        MaterialPartsIssue[]           @relation("MaterialsPartsHasBranch")
  numberPlates                                                         NumberPlate[]                  @relation("BranchHasNumberPlate")
  numberPlateTransfersFrom                                             NumberPlateTransfer[]          @relation("FromBranchTransfers")
  numberPlateTransfersTo                                               NumberPlateTransfer[]          @relation("ToBranchTransfers")
  payments                                                             Payment[]                      @relation("BranchHasPayments")
  purchaseSpareInvoiceItems                                            PurchaseSpareInvoiceItem[]     @relation("PurchaseSpareInvoiceHasBranch")
  assignedQuotations                                                   Quotation[]                    @relation("QuotationAssignedBranch")
  quotations                                                           Quotation[]                    @relation("QuotationHasBranch")
  Ramp                                                                 Ramp[]
  saleInvoices                                                         SaleInvoice[]                  @relation("SaleInvoiceHasBranch")
  saleSpareInvoices                                                    SaleSpareInvoice[]             @relation("SaleSparesHasBranch")
  saleSpareInvoiceItems                                                SaleSpareInvoiceItem[]         @relation("SaleSpareInvoiceHasBranch")
  SpareInventoryTransfer_SpareInventoryTransfer_fromBranchToBranch     SpareInventoryTransfer[]       @relation("SpareInventoryTransfer_fromBranchToBranch")
  SpareInventoryTransfer_SpareInventoryTransfer_toBranchToBranch       SpareInventoryTransfer[]       @relation("SpareInventoryTransfer_toBranchToBranch")
  sparesInventory                                                      SparesInventory[]              @relation("SparesInventoryHasBranch")
  stockChecks                                                          StockCheck[]                   @relation("StockCheckHasBranch")
  VehicleInventory                                                     VehicleInventory[]
  VehicleInventoryTransfer_VehicleInventoryTransfer_fromBranchToBranch VehicleInventoryTransfer[]     @relation("VehicleInventoryTransfer_fromBranchToBranch")
  VehicleInventoryTransfer_VehicleInventoryTransfer_toBranchToBranch   VehicleInventoryTransfer[]     @relation("VehicleInventoryTransfer_toBranchToBranch")
  VehiclePurchaseChallan                                               VehiclePurchaseChallan[]
  idCreation                                                           idCreation[]
  transactions                                                         Transactions[]                 @relation("TransactionsHasBranch")
  manufacturer                                                         Manufacturer[]                 @relation("BanchHasManufacturers")
  bankDetails                                                          BankDetails[]                  @relation("BranchHasBankDetails")
  contacts                                                             BranchContacts[]               @relation("BranchHasManyBranchContacts")
  personInCharge                                                       User[]                         @relation("BranchHasManyUser")
  employeeProfiles                                                     EmployeeProfile[]              @relation("UserProfileHasBranch")
  purchaseSpareInvoices                                                PurchaseSpareInvoice[]         @relation("PurchaseSpareInvoiceRelatedToBranch")
}

model BranchContacts {
  id        String   @id @default(cuid()) @db.VarChar(25)
  phone     String?
  category  String?
  createdAt DateTime
  updatedAt DateTime @updatedAt
  branches  Branch[] @relation("BranchHasManyBranchContacts")
}

model Address {
  id               String            @id @default(cuid()) @db.VarChar(25)
  locality         String?
  pincode          String?
  createdAt        DateTime
  updatedAt        DateTime          @updatedAt
  createdById      String?           @map("createdBy") @db.VarChar(25)
  districtId       String?           @map("district") @db.VarChar(25)
  countryId        String?           @map("country") @db.VarChar(25)
  stateId          String?           @map("state") @db.VarChar(25)
  line1            String?
  line2            String?
  line3            String?
  country          Country?          @relation("AddressHasCountry", fields: [countryId], references: [id], onUpdate: NoAction)
  createdBy        User?             @relation("AddressWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  district         City?             @relation("AddressHasCity", fields: [districtId], references: [id], onUpdate: NoAction)
  state            State?            @relation("AddressHasState", fields: [stateId], references: [id], onUpdate: NoAction)
  branches         Branch[]          @relation("BranchHasAddress")
  customers        Customer[]        @relation("CustomerHasAddress")
  customersShip    Customer[]        @relation("CustomerHasShippingAddress")
  employeeProfiles EmployeeProfile[] @relation("UserProfileHasAddress")
  financers        Financer[]        @relation("FinancerHasAddress")
  insurers         Insurance[]       @relation("InsuranceHasAddress")
  insurersShip     Insurance[]       @relation("InsuranceHasShippingAddress")
  manufacturers    Manufacturer[]    @relation("ManufacturerHasAddress")
  subDealers       SubDealer[]       @relation("SubDealerHasAddress")
  subDealersShip   SubDealer[]       @relation("SubDealerHasShippingAddress")
  suppliers        Supplier[]        @relation("SupplierHasAddress")
  suppliersShip    Supplier[]        @relation("SupplierHasShippingAddress")
}

model BankDetails {
  id               String            @id @default(cuid()) @db.VarChar(25)
  name             String?
  accountName      String?
  ifsc             String?
  accountNumber    String?
  createdAt        DateTime
  updatedAt        DateTime          @updatedAt
  createdById      String?           @map("createdBy") @db.VarChar(25)
  accountType      String?
  accountBalance   Decimal?
  createdBy        User?             @relation("CompanyBankDetailsWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  companyPayments  CompanyPayment[]  @relation("CompanyPaymentBankDetails")
  employeeProfiles EmployeeProfile[] @relation("UserProfileHasBankDetails")
  payments         Payment[]         @relation("BankHasPayments")
  branches         Branch[]          @relation("BranchHasBankDetails")
  subDealers       SubDealer[]       @relation("SubDealerHasBankDetails")
  suppliers        Supplier[]        @relation("SupplierHasBankDetails")
}

model Financer {
  id                String             @id @default(cuid()) @db.VarChar(25)
  name              String?            @unique(map: "default$default.Financer.name._UNIQUE")
  logo              String?
  createdAt         DateTime
  updatedAt         DateTime           @updatedAt
  createdById       String?            @map("createdBy") @db.VarChar(25)
  dealerType        String?
  GSTIN             String?
  status            String?
  email             String?
  addressId         String?            @map("address") @db.VarChar(25)
  address           Address?           @relation("FinancerHasAddress", fields: [addressId], references: [id], onUpdate: NoAction)
  createdBy         User?              @relation("FinancerWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  contact           FinancerContact[]  @relation("FinancerHasFinancerContact")
  loans             Loan[]             @relation("BookingHasFinancer")
  quotationVehicles QuotationVehicle[] @relation("QuotationVehicleHasFinancer")
  CompanyPayment    CompanyPayment[]   @relation("FinancerUsedForCompanyPayment")
}

model FinancerContact {
  id          String    @id @default(cuid()) @db.VarChar(25)
  name        String?
  designation String?
  number      String?
  whatsapp    Boolean?
  valid       Boolean?
  createdAt   DateTime
  updatedAt   DateTime  @updatedAt
  financerId  String?   @map("financer") @db.VarChar(25)
  createdById String?   @map("createdBy") @db.VarChar(25)
  createdBy   User?     @relation("FinancerContactWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  financer    Financer? @relation("FinancerHasFinancerContact", fields: [financerId], references: [id], onUpdate: NoAction)
}

model Insurance {
  id                String             @id @default(cuid()) @db.VarChar(25)
  name              String?            @unique(map: "default$default.Insurance.name._UNIQUE")
  logo              String?
  createdAt         DateTime
  updatedAt         DateTime           @updatedAt
  createdById       String?            @map("createdBy") @db.VarChar(25)
  dealerType        String?
  GSTIN             String?
  status            String?
  email             String?
  addressId         String?            @map("address") @db.VarChar(25)
  cashless          String?
  shippingAddressId String?            @map("shippingAddress") @db.VarChar(25)
  estimates         Estimate[]         @relation("EstimateHasInsurer")
  address           Address?           @relation("InsuranceHasAddress", fields: [addressId], references: [id], onUpdate: NoAction)
  createdBy         User?              @relation("InsuranceWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  shippingAddress   Address?           @relation("InsuranceHasShippingAddress", fields: [shippingAddressId], references: [id], onUpdate: NoAction)
  contact           InsuranceContact[] @relation("InsuranceHasInsuranceContact")
  vehicleInsurances VehicleInsurance[] @relation("VehicleInsuranceHasInsurance")
}

model InsuranceContact {
  id          String     @id @default(cuid()) @db.VarChar(25)
  name        String?
  designation String?
  number      String?
  whatsapp    Boolean?
  valid       Boolean?
  createdAt   DateTime
  updatedAt   DateTime   @updatedAt
  createdById String?    @map("createdBy") @db.VarChar(25)
  insuranceId String?    @map("insurance") @db.VarChar(25)
  createdBy   User?      @relation("InsuranceContactWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  insurance   Insurance? @relation("InsuranceHasInsuranceContact", fields: [insuranceId], references: [id], onUpdate: NoAction)
}

model Supplier {
  id                     String                   @id @default(cuid()) @db.VarChar(25)
  name                   String?
  dealerType             String?
  GSTIN                  String?
  status                 String?
  remarks                String?
  createdAt              DateTime
  updatedAt              DateTime                 @updatedAt
  addressId              String?                  @map("address") @db.VarChar(25)
  createdById            String?                  @map("createdBy") @db.VarChar(25)
  email                  String?
  shippingAddressId      String?                  @map("shippingAddress") @db.VarChar(25)
  payments               Payment[]                @relation("SupplierReceivedPayment")
  purchaseSpareInvoices  PurchaseSpareInvoice[]   @relation("LinkedToSupplier")
  SparePartReceipt       SparePartReceipt[]
  supplierType           String[]
  address                Address?                 @relation("SupplierHasAddress", fields: [addressId], references: [id], onUpdate: NoAction)
  createdBy              User?                    @relation("SupplierWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  shippingAddress        Address?                 @relation("SupplierHasShippingAddress", fields: [shippingAddressId], references: [id], onUpdate: NoAction)
  // Supplier_supplierType  Supplier_supplierType[]
  VehiclePurchaseChallan VehiclePurchaseChallan[]
  bank                   BankDetails[]            @relation("SupplierHasBankDetails")
  contact                SupplierContact[]        @relation("SupplierHasSupplierContact")
}

model SupplierContact {
  id          String     @id @default(cuid()) @db.VarChar(25)
  name        String?
  designation String?
  number      String?
  whatsapp    Boolean?
  valid       Boolean?
  createdAt   DateTime
  updatedAt   DateTime   @updatedAt
  createdById String?    @map("createdBy") @db.VarChar(25)
  createdBy   User?      @relation("SupplierContactWasCreatedByUser", fields: [createdById], references: [id], onUpdate: NoAction)
  suppliers   Supplier[] @relation("SupplierHasSupplierContact")
}

model SubDealer {
  id                String             @id @default(cuid()) @db.VarChar(25)
  name              String?
  dealerType        String?
  GSTIN             String?
  status            String?
  email             String?
  remarks           String?
  subDealerType     String?
  discountType      String?
  createdAt         DateTime
  updatedAt         DateTime           @updatedAt
